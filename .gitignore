# Dependencies
node_modules/

# Build output
dist/
build/
# ...but packages/desktop/build/ holds the app and tray icons, which are source
# assets rather than output. The blanket rule above was excluding them from the
# repo entirely, so a fresh checkout — every CI run — packaged with no icons.
!packages/desktop/build/
*.tsbuildinfo

# Bundled whisper.cpp binary and the ~500MB model — fetched by scripts/fetch-whisper.sh,
# never committed. A public repo must not carry a half-gigabyte blob in its history.
resources/

# Packaged artifacts (produced by CI, not locally)
release/

# Scratch clone/build tree for whisper.cpp. fetch-whisper.sh removes it on
# success, but a failed build would otherwise leave it staged for commit.
.whisper-build/

# Test output
playwright-report/
test-results/
coverage/

# Logs and env
*.log
npm-debug.log*
.env
.env.*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
